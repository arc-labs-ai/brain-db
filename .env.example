# Brain deployment config. Copy to `.env` and fill in the required values:
#
#   cp .env.example .env
#
# docker compose reads `.env` automatically. `.env` is gitignored — never
# commit real keys.

# --- Required ---------------------------------------------------------------

# Operator admin secret gating the /v1/* admin plane (API-key mint, stats,
# revoke). The admin listener refuses to start without it. Use a long random
# value; rotate it like any other secret.
BRAIN__ADMIN__TOKEN=

# --- Optional (sensible defaults shown) -------------------------------------

# Which released image to run. Pin a real version in production instead of
# `latest`; best of all, pin a digest from the GitHub Release.
#   BRAIN_VERSION=0.4.0
BRAIN_VERSION=latest

# The key that seals stored LLM credentials at rest, as 64 hex characters.
# Leave empty and Brain generates one into its data directory on first boot,
# which protects a copied volume or a backup archive but not someone holding
# the whole data directory. Set it to keep the sealing key off Brain's disk.
BRAIN__LLM__CREDENTIALS__KEK=

# Fallback model id, used when a namespace's registered credential does not
# name one. There is no provider key to set here: each namespace registers
# its own through LLM_CREDENTIAL_PUT and the model-backed stages bill to it.
BRAIN__LLM__MODEL=gpt-4o-mini

# Host port mappings. Change if 8080/9091 are already taken on the host.
BRAIN_WIRE_PORT=8080
BRAIN_HTTP_PORT=9091

# Any config field is overridable as BRAIN__SECTION__FIELD. Examples:
#   BRAIN__STORAGE__SHARD_COUNT=4          # one shard pins one core
#   BRAIN__SHARD__ARENA_CAPACITY_BYTES=4GiB
#   BRAIN__SHARD__WAL_SEGMENT_SIZE_BYTES=512MiB
# Do NOT set BRAIN__RERANK__ENABLED=true on the stock image: it carries no
# cross-encoder model, and enabling rerank without one is a fatal
# CrossEncoderInitFailed at boot, not a degradation.
