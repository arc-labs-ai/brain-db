# Brain deployment config. Copy to `.env` and fill in the required values:
#
#   cp .env.example .env
#
# docker compose reads `.env` automatically. `.env` is gitignored — never
# commit real keys.

# --- Required ---------------------------------------------------------------

# Where Brain resolves a namespace's LLM credential. Required: the serving key
# belongs to the namespace and is not known until a write names one, so there
# is no process-wide key to fall back to.
BRAIN__LLM__BROKER__URL=

# Brain's own identity to the broker. NOT a provider key: it authenticates
# Brain so the broker will swap a namespace grant for the tenant's real key on
# the way upstream, which is what keeps tenant keys out of Brain's WAL,
# snapshots and backups.
BRAIN__LLM__BROKER__SERVICE_KEY=

# Operator admin secret gating the /v1/* admin plane (API-key mint, stats,
# revoke). The admin listener refuses to start without it. Use a long random
# value; rotate it like any other secret.
BRAIN__ADMIN__TOKEN=

# --- Optional (sensible defaults shown) -------------------------------------

# Which released image to run. Pin a real version in production instead of
# `latest`; best of all, pin a digest from the GitHub Release.
#   BRAIN_VERSION=0.1.0
BRAIN_VERSION=latest

# Shard-wide client for the entity disambiguator. Not the serving credential:
# HyPE and extraction resolve per namespace from the broker above, so leaving
# this empty costs the second opinion on ambiguous partial matches and nothing
# else.
BRAIN__LLM__API_KEY=

# Model id — the provider is derived from this. gpt-4o-mini → OpenAI,
# claude-haiku-4-5 → Anthropic, etc. Must match the key above.

# Host port mappings. Change if 8080/9091 are already taken on the host.
BRAIN_WIRE_PORT=8080
BRAIN_HTTP_PORT=9091

# Any config field is overridable as BRAIN__SECTION__FIELD. Examples:
#   BRAIN__STORAGE__SHARD_COUNT=4          # one shard pins one core
#   BRAIN__SHARD__ARENA_CAPACITY_BYTES=4GiB
#   BRAIN__RERANK__ENABLED=true            # load the cross-encoder reranker
